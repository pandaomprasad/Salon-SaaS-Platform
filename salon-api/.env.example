# ============================================================
# SALON SAAS PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# ── Server & Environment ──────────────────────────────────────
PORT=6969
NODE_ENV=production
ALLOWED_ORIGINS=https://yoursalon.com,https://admin.yoursalon.com,https://panel.yoursalon.com

# ── Database ──────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/salon-db?retryWrites=true&w=majority

# ── JWT Authentication Secrets ────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_production_access_key_change_me
JWT_REFRESH_SECRET=your_super_secret_production_refresh_key_change_me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Email Service (Brevo / SMTP) ──────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=xsmtpsib-your-smtp-key
# ── Email Verification & Link Config ──────────────────────────
EMAIL_VERIFICATION_SECRET=your_super_secret_email_verification_key_change_me
APP_BASE_URL=https://yoursalon.com
MAIL_FROM="ST CUT" <no-reply@stcut.com>

# ── Redis Cache & WebSockets ──────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Google Maps API Key ───────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MS=900000
